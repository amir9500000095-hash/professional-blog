# پایگاه داده (Database)
MONGODB_URI=mongodb://localhost:27017/professional-blog
DB_HOST=localhost
DB_PORT=27017
DB_NAME=professional-blog

# سرور (Server)
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# JWT احراز هویت (JWT Authentication)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRE=30d

# Redis برای Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# تنظیمات ایمیل (Email Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@professionalblog.com
MAIL_SERVICE=gmail

# آپلود فایل (File Upload)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf

# کلید AWS (برای ذخیره‌سازی ابری)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=professional-blog-uploads

# کلیدهای شبکه‌های اجتماعی (Social Media Keys)
TWITTER_API_KEY=your_twitter_key
FACEBOOK_APP_ID=your_facebook_app_id
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# تنظیمات SEO
SITE_NAME=Professional Blog
SITE_URL=https://professionalblog.com
SITE_DESCRIPTION=A comprehensive technology blog platform

# تنظیمات امنیت (Security Settings)
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=10

# متغیرهای توسعه (Development Variables)
LOG_LEVEL=debug
DEBUG=true
