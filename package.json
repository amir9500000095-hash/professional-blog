{
  "name": "professional-blog",
  "version": "1.0.0",
  "description": "A comprehensive technology blog platform with advanced features",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec node backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc backend/**/*.ts",
    "build:frontend": "cd frontend && npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node backend/dist/server.js",
    "docker:build": "docker build -t professional-blog .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "node backend/scripts/migrate.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "validator": "^13.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.6",
    "redis": "^4.6.11",
    "axios": "^1.5.0",
    "sharp": "^0.32.6",
    "slug": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "eslint": "^8.50.0",
    "@eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "blog",
    "technology",
    "cms",
    "platform",
    "management"
  ],
  "author": "amir9500000095",
  "license": "MIT"
}
